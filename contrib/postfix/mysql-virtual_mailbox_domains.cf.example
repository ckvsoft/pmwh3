# postfix mysql map -> mail stack routing table (NOT pmwh3-owned)
#
# wired in main.cf as:
#   virtual_mailbox_domains =
#       proxy:mysql:/etc/postfix/sql/mysql-virtual_mailbox_domains.cf
# non-empty result = this server is the final destination for the
# domain. Reads the stack-owned postfix_transport table -- see
# postfix_transport.sql and README.md in this directory.
#
# Variables: @DB_HOST@ @DB_NAME@ @DB_USER@ @DB_PASS@
user = @DB_USER@
password = @DB_PASS@
dbname = @DB_NAME@
hosts = @DB_HOST@
query = SELECT destination FROM postfix_transport WHERE domain='%s'
